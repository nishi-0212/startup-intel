# Copy to backend/.env and fill in your keys. Never commit the real .env file.
TAVILY_API_KEY=
GROQ_API_KEY=

# Models
GROQ_MODEL=openai/gpt-oss-120b
# Fast model for extraction (has its own Groq rate limit). Falls back to GROQ_MODEL automatically if unavailable.
GROQ_FAST_MODEL=openai/gpt-oss-20b
# gpt-oss models "think" before answering; low = much faster, fewer rate-limit waits
GROQ_REASONING=low

# Search: "advanced" = ~3 relevant passages per page (2 Tavily credits/search); "basic" = 1 snippet (1 credit)
TAVILY_DEPTH=advanced
# Search/LLM responses cached on disk for 24h, so repeat runs are near-instant
CACHE_TTL=86400

# Budgets and limits
MAX_API_CALLS=80
MAX_TOKENS=60000
# Part of the budget held back so the final report always gets written
SYNTH_RESERVE_CALLS=6
SYNTH_RESERVE_TOKENS=8000
# Hard limit for one run; when hit, the report is built from what was collected and Retry finishes the rest
JOB_TIMEOUT=120
# Longest single wait on an API rate limit (seconds)
MAX_RETRY_WAIT=20
HTTP_TIMEOUT=20
HTTP_RETRIES=4
# Parallel LLM calls per model (1 is safest on Groq free tier)
LLM_CONCURRENCY=1

# Storage
DB_PATH=jobs.db

# Deployment: comma-separated frontend URLs allowed to call the API (your Vercel URL in production)
ALLOWED_ORIGINS=http://localhost:5173

# Demo: set to 1 to simulate one Tavily timeout (shows retry recovery)
SIMULATE_FAILURE=0